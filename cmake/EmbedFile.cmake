# embed_file(<input> <output.cpp> <symbol>): writes a .cpp defining
#   extern const unsigned char <symbol>[];  extern const unsigned int <symbol>Size;
# with the file's bytes, at configure time.
function(embed_file input output symbol)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
    file(WRITE "${output}"
        "// Generated by cmake/EmbedFile.cmake from ${input}\n"
        "extern const unsigned char ${symbol}[];\n"
        "extern const unsigned int ${symbol}Size;\n"
        "const unsigned char ${symbol}[] = {\n${bytes}\n};\n"
        "const unsigned int ${symbol}Size = ${size};\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
endfunction()
