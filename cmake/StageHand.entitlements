<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- StageHand.app's entitlements for its Developer ID signature with the hardened runtime
     (docs/macos.md, "Signing"; ReleaseUMP R4-16). Used by the release signing
     (sign-notarize.sh entitlements option), not by the build's ad-hoc signature, which has
     no hardened runtime and so no library validation to turn off.

     disable-library-validation: the hardened runtime otherwise loads only code signed by
     Apple or by our own team, so every CLAP plugin signed by someone else, or ad hoc (a
     development build), would fail to load.

     Nothing else: StageHand opens audio outputs only, so no audio-input entitlement
     (decision 2), and it uses no JIT. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
